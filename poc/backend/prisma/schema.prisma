generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FIELD_OPS
  COMMAND
  ANALYST
}

enum IncidentStatus {
  REPORTED
  ACCEPTED
  EN_ROUTE
  ON_SCENE
  CLOSED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          Role
  device        Device?
  incidents     Incident[] @relation("AssignedIncidents")
  createdAt     DateTime @default(now())
}

model Device {
  id        String   @id @default(uuid())
  label     String
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  createdAt DateTime @default(now())
}

model Incident {
  id            String   @id @default(uuid())
  title         String
  description   String
  type          String
  lat           Float
  lng           Float
  asset         Asset?   @relation(fields: [assetId], references: [id])
  assetId       String?
  assignedTo    User?    @relation("AssignedIncidents", fields: [assignedToId], references: [id])
  assignedToId  String?
  statuses      IncidentStatusHistory[]
  media         Media[]
  alerts        Alert[]
  createdAt     DateTime @default(now())
}

model IncidentStatusHistory {
  id          String         @id @default(uuid())
  incident    Incident       @relation(fields: [incidentId], references: [id])
  incidentId  String
  status      String
  updatedBy   User?          @relation(fields: [updatedById], references: [id])
  updatedById String?
  createdAt   DateTime       @default(now())
}

model LocationPing {
  id       String   @id @default(uuid())
  device   Device?  @relation(fields: [deviceId], references: [id])
  deviceId String?
  lat      Float
  lng      Float
  speed    Float?
  heading  Float?
  createdAt DateTime @default(now())
}

model Asset {
  id        String   @id @default(uuid())
  make      String
  model     String
  plate     String
  metadata  Json
  incidents Incident[]
}

model Media {
  id         String   @id @default(uuid())
  url        String
  description String?
  incident   Incident @relation(fields: [incidentId], references: [id])
  incidentId String
  createdAt  DateTime @default(now())
}

model Alert {
  id        String   @id @default(uuid())
  type      String
  device    Device?  @relation(fields: [deviceId], references: [id])
  deviceId  String?
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())
}

model AnalyticsSnapshot {
  id        String   @id @default(uuid())
  payload   Json
  createdAt DateTime @default(now())
}
